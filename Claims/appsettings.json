{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SqlServer": {
    "ConnectionString": ""
  },
  "MongoDb": {
    "DatabaseName": "Claims",
    "ConnectionString": ""
  },
  "ServiceBus": {
    "ConnectionString": "",
    "QueueName": "claims-audit-outbox"
  },
  "OutboxProcessor": {
    "BatchSize": 20,
    "PollIntervalMs": 1000
  },
  "ValidationRules": {
    "Claims": {
      "MaxDamageCost": 100000
    },
    "Covers": {
      "MaxInsurancePeriodYears": 1
    }
  },
  "PremiumPricing": {
    "BaseDayRate": 1250,
    "TypeMultipliers": {
      "Yacht": 1.1,
      "PassengerShip": 1.2,
      "Tanker": 1.5,
      "Other": 1.3
    },
    "DiscountRules": {
      "DayRangeDiscountRules": [
        {
          "Days": {
            "From": 1,
            "To": 30
          },
          "YachtDiscount": 0.0,
          "OtherDiscount": 0.0
        },
        {
          "Days": {
            "From": 31,
            "To": 180
          },
          "YachtDiscount": 0.05,
          "OtherDiscount": 0.02
        }
      ],
      "Remaining": {
        "YachtDiscount": 0.08,
        "OtherDiscount": 0.03
      }
    }
  },
  "AllowedHosts": "*"
}
